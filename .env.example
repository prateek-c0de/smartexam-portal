# SmartExam Portal — Environment Configuration Example
# Copy this file to `.env` and supply your project values.
# NEVER commit `.env` or expose service-role / LLM API keys in `VITE_*` variables.

# Required — Supabase project URL and public anon key (RLS enforced on all tables)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-placeholder

# Optional — WebRTC STUN / TURN servers for real-time camera, mic & screen monitoring
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional — Local Ollama endpoint for teacher-side AI draft question generation (no API key)
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODEL=llama3.2:3b

# Optional — Self-hosted mirror path for MediaPipe WASM & TFLite models (defaults to official CDN)
VITE_MEDIAPIPE_WASM_ROOT=
VITE_MEDIAPIPE_FACE_MODEL_URL=
VITE_MEDIAPIPE_OBJECT_MODEL_URL=

# ---------------------------------------------------------------------------
# Server-side ONLY secrets (set via `supabase secrets set`, NEVER in `.env` with VITE_ prefix):
#   AI_PROVIDER=ollama            # ollama | gemini | openai_compatible
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#   OLLAMA_MODEL=llama3.2:3b
#   GEMINI_API_KEY=your-server-side-gemini-key
#   OPENAI_API_KEY=your-server-side-openai-key
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   ALLOWED_ORIGIN=https://your-production-domain.edu
# ---------------------------------------------------------------------------
